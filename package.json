{
  "name": "@fenghoer/dsh-context-guard",
  "version": "0.4.4",
  "type": "module",
  "description": "DSH 插件：危险命令先确认、重复输出自动去重、单轮 bash 80/160 门禁、整文件 cat 与裸 curl 直接拦截；长输出完整落盘不丢证据。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "config",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "PLAN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/person-clouds/dsh-context-guard.git"
  },
  "homepage": "https://github.com/person-clouds/dsh-context-guard#readme",
  "bugs": {
    "url": "https://github.com/person-clouds/dsh-context-guard/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "context",
    "token",
    "bash",
    "compaction",
    "archive",
    "security",
    "approval"
  ],
  "engines": {
    "node": ">=22.5.0"
  }
}
