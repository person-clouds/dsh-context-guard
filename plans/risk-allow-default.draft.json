{
  "version": 1,
  "review": {
    "status": "draft-for-review",
    "purpose": "审阅稿，不是运行配置。实施时复制为 config/risk-allow-default.json，并删除本 review 段。",
    "classificationRules": [
      "裸 IP（IPv4/IPv6，非 loopback）先按个人服务处理，不进入内置",
      "loopback（localhost、127.0.0.1、[::1]）保留为通用本地默认",
      "个人/内部域名与 IP 只放用户 risk-allow.json"
    ],
    "excludedHosts": [
      {
        "host": "zh-gem-r7.tailb6e152.ts.net",
        "reason": "个人 Tailscale 服务；不进入插件内置，只保留在用户 risk-allow.json"
      }
    ],
    "checklist": [
      "hosts：按 local / codeHosting / api / docs / techMedia 分组逐项确认是否进入内置默认",
      "rm：确认临时目录、test 目录、~/opt、artifact 目录的保留范围",
      "probes：确认 mktemp 与 touch 自清理写探测是否保留",
      "commands：确认 sudo 只读命令与 systemctl 只读子命令清单",
      "git：只读子命令仅登记供审阅，不参与放行匹配"
    ]
  },
  "hosts": {
    "local": [
      "localhost",
      "127.0.0.1",
      "[::1]"
    ],
    "codeHosting": [
      "github.com",
      "gitee.com",
      "raw.githubusercontent.com",
      "gitlab.com",
      "github.blog"
    ],
    "api": [
      "api.deepseek.com"
    ],
    "docs": [
      "docs.romm.app"
    ],
    "techMedia": [
      "news.ycombinator.com",
      "www.ruanyifeng.com",
      "sspai.com",
      "www.infoq.cn",
      "www.smashingmagazine.com",
      "css-tricks.com",
      "web.dev",
      "alistapart.com",
      "tympanus.net",
      "www.producthunt.com",
      "uxdesign.cc",
      "www.nngroup.com",
      "frontendfoc.us",
      "javascriptweekly.com",
      "react.statuscode.com",
      "sidebar.io",
      "www.designmilk.com",
      "www.itsnicethat.com"
    ]
  },
  "rm": {
    "tempRoots": [
      "/tmp",
      "/var/tmp",
      "$TMPDIR",
      "${TMPDIR}"
    ],
    "homeOpt": true,
    "testDirNames": [
      "test",
      "tests",
      "__tests__"
    ],
    "testDirPatterns": [
      "^test[-_.]",
      "[-_.]test$",
      "[.](?:test|spec)$"
    ],
    "artifactDirs": [
      "node_modules",
      "dist",
      "build",
      "coverage",
      ".cache",
      ".next",
      ".nuxt",
      ".output",
      ".parcel-cache",
      ".svelte-kit",
      ".turbo",
      ".vite",
      ".nyc_output",
      "__pycache__",
      ".pytest_cache",
      ".mypy_cache",
      ".ruff_cache",
      "target",
      ".gradle",
      "out",
      "tmp",
      "temp"
    ]
  },
  "probes": {
    "mktempRoots": [
      "/tmp",
      "/var/tmp",
      "$TMPDIR",
      "${TMPDIR}"
    ],
    "mktempTemplateMinX": 3,
    "writeTestFilePattern": "(?:^|[._-])(?:dsh[._-]?)?write[._-]?test(?:$|[._-])",
    "touchThenRm": true,
    "mktempThenRm": true
  },
  "commands": {
    "sudoReadOnly": [
      "ls",
      "stat",
      "readlink",
      "realpath",
      "file",
      "wc",
      "head",
      "tail",
      "cat",
      "grep",
      "id",
      "whoami",
      "groups",
      "pwd",
      "uptime",
      "uname",
      "df",
      "du",
      "free",
      "ps",
      "netstat",
      "journalctl",
      "systemctl"
    ],
    "systemctlReadOnly": [
      "status",
      "show",
      "is-active",
      "is-enabled",
      "is-failed",
      "list-units",
      "list-unit-files",
      "list-timers",
      "cat",
      "help"
    ]
  },
  "git": {
    "readOnlySubcommands": [
      "status",
      "log",
      "diff",
      "show",
      "rev-parse",
      "ls-files",
      "grep",
      "blame",
      "describe",
      "shortlog"
    ],
    "policy": "只读子命令不触发风险；破坏形态仍由 risk.js 拦截，本组不参与放行匹配"
  }
}
